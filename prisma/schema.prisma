// ⚠️ ეს ცხრილი (და, სავარაუდოდ, import_batches.rejected_count-ის მსგავსი კიდევ სხვა
// ველები/ცხრილები) თავდაპირველად შეიქმნა RAW SQL-ით, schema.prisma-ს გვერდის ავლით.
// 2026-07-11-ს, `prisma db push` ბრძანებამ ეს ცხრილი წაშალა (რადგან schema.prisma-ში
// არ იყო აღწერილი) — აღდგენილია backup-იდან. ᲐᲠᲐᲡᲓᲠᲝᲡ გაუშვა `prisma db push`
// ან `prisma migrate` ამის შემდეგ, სანამ jer არ დარწმუნდები `prisma db pull`-ით,
// რომ schema.prisma ზუსტად ემთხვევა რეალურ ბაზას — შესაძლოა კიდევ არსებობდეს
// მსგავსი, აქ ჯერ არ-აღწერილი raw-SQL ცხრილები.
model AutodocReferenceData {
  id                 Int      @id @default(autoincrement())
  make               String?
  model              String?
  category_en        String?
  autodoc_category_id Int?
  brand              String?
  article_code       String?
  description        String?
  image_url          String?
  created_at         DateTime? @default(now())
  article_id         BigInt?
  cross_codes        String?
  oem_codes          String?

  @@map("autodoc_reference_data")
}

model Shipment {
  id               String         @id @default(uuid())
  orderId          String
  pickupType       String         @default("OWN_SHOP")
  supplierId       String?
  pickupAddress    String
  pickupPhone      String         @default("")
  deliveryAddress  String         @default("")
  status           String         @default("PENDING_CONFIRMATION")
  deliveryProvider String?
  providerOrderId  String?
  vehicleType      String         @default("BIKE")
  courierName      String?
  courierPhone     String?
  trackingUrl      String?
  readyAt          DateTime?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  items            ShipmentItem[]

  @@index([orderId], map: "idx_shipments_order_id")
  @@index([supplierId], map: "idx_shipments_supplier_id")
  @@map("shipments")
}

model ShipmentItem {
  id          String     @id @default(uuid())
  shipmentId  String
  orderItemId String
  qty         Int        @default(1)
  shipment    Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([shipmentId], map: "idx_shipment_items_shipment_id")
  @@index([orderItemId], map: "idx_shipment_items_order_item_id")
  @@map("shipment_items")
}

model VinCache {
  vin          String   @id
  responseData Json     @map("response_data")
  createdAt    DateTime @default(now())

  @@map("vin_cache")
}
