model search_knowledge {
  id           Int       @id @default(autoincrement())
  query        String
  normalized   String
  category_id  Int?
  result_count Int?      @default(0)
  success      Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  @@index([normalized], map: "idx_search_knowledge_normalized")
}

model site_visits {
  id         Int       @id @default(autoincrement())
  session_id String
  user_id    String?
  path       String?
  referrer   String?
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at], map: "idx_visits_date")
  @@index([session_id], map: "idx_visits_session")
}

model supplier_notifications {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  supplierId String
  type       String
  title      String
  message    String
  url        String?
  isRead     Boolean?  @default(false)
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  suppliers  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: NoAction)

