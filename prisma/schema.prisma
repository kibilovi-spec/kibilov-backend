}

model vehicle_engines {
  vehicle_id     Int          @id
  model_id       String
  make           String?      @db.VarChar(100)
  model_name     String?      @db.VarChar(200)
  engine_name    String?      @db.VarChar(200)
  year_from      Int?
  year_to        Int?
  fuel_type      String?      @db.VarChar(50)
  power_kw       Decimal?     @db.Decimal(8, 2)
  capacity       String?      @db.VarChar(20)
  vehicle_models VehicleModel @relation(fields: [model_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([model_id], map: "idx_vehicle_engines_model_id")
}

model vehicle_generations {
  id         Int      @id @default(autoincrement())
  make       String
  model      String
  generation String
  year_from  Int?
  year_to    Int?
  aliases    String[]

  @@unique([make, model, generation])
  @@index([generation], map: "idx_vg_generation")
  @@index([make, model], map: "idx_vg_make_model")
}

model vehicle_part_map {
  id               Int       @id @default(autoincrement())
  vehicle_id       String
  part_category_id Int
  oem_code         String
  position         String?
  engine_code      String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  @@unique([vehicle_id, oem_code])
  @@index([part_category_id], map: "idx_vpm_category")
  @@index([oem_code], map: "idx_vpm_oem")
  @@index([vehicle_id], map: "idx_vpm_vehicle")
}

model vehicle_variants {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  vehicle_id   String    @unique @db.VarChar(20)
  model_id     String
  make_id      String
  name         String?   @db.VarChar(200)
  year_from    Int?
  year_to      Int?
  engine       String?   @db.VarChar(100)
  power_kw     Int?
  power_hp     Int?
  fuel         String?   @db.VarChar(50)
  body_type    String?   @db.VarChar(50)
  vehicle_slug String?   @db.VarChar(200)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  @@index([make_id], map: "idx_vv_make_id")
  @@index([model_id], map: "idx_vv_model_id")
  @@index([vehicle_slug], map: "idx_vv_slug")
  @@index([vehicle_id], map: "idx_vv_vehicle_id")
  @@index([year_from, year_to], map: "idx_vv_year")
}

